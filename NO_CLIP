local player = game.Players.LocalPlayer
local userInputService = game:GetService("UserInputService")
local runService = game:GetService("RunService")

local character = player.Character or player.CharacterAdded:Wait()
local gui = Instance.new("ScreenGui", player:WaitForChild("PlayerGui"))
gui.ResetOnSpawn = false

local noclipEnabled = false
local noclipConnection

-- Tạo khung
local toggleFrame = Instance.new("Frame")
toggleFrame.Size = UDim2.new(0, 180, 0, 100)
toggleFrame.Position = UDim2.new(0.7, 0, 0.3, 0)
toggleFrame.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
toggleFrame.BorderSizePixel = 2
toggleFrame.Active = true
toggleFrame.Draggable = false
toggleFrame.Parent = gui

-- Nút xóa
local closeButton = Instance.new("TextButton")
closeButton.Size = UDim2.new(0, 25, 0, 25)
closeButton.Position = UDim2.new(1, -30, 0, 5)
closeButton.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
closeButton.Text = "X"
closeButton.TextColor3 = Color3.new(1, 1, 1)
closeButton.Parent = toggleFrame

-- Nút noclip
local toggleButton = Instance.new("TextButton")
toggleButton.Size = UDim2.new(0.9, 0, 0.5, 0)
toggleButton.Position = UDim2.new(0.05, 0, 0.4, 0)
toggleButton.Text = "Bật Noclip"
toggleButton.BackgroundColor3 = Color3.fromRGB(128, 128, 128)
toggleButton.TextColor3 = Color3.new(1, 1, 1)
toggleButton.Parent = toggleFrame

-- Kéo thả mobile
local dragging = false
local dragInput, dragStart, startPos

local function updateInput(input)
	local delta = input.Position - dragStart
	toggleFrame.Position = UDim2.new(
		startPos.X.Scale,
		startPos.X.Offset + delta.X,
		startPos.Y.Scale,
		startPos.Y.Offset + delta.Y
	)
end

toggleFrame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = toggleFrame.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

toggleFrame.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

userInputService.InputChanged:Connect(function(input)
	if dragging and input == dragInput then
		updateInput(input)
	end
end)

-- Xử lý Noclip logic
local function enableNoclip(char)
	if noclipConnection then noclipConnection:Disconnect() end

	noclipConnection = runService.Stepped:Connect(function()
		if noclipEnabled then
			for _, part in pairs(char:GetDescendants()) do
				if part:IsA("BasePart") then
					pcall(function()
						part.CanCollide = false
					end)
				end
			end
		end
	end)
end

local function disableNoclip(char)
	if noclipConnection then
		noclipConnection:Disconnect()
		noclipConnection = nil
	end

	for _, part in pairs(char:GetDescendants()) do
		if part:IsA("BasePart") then
			pcall(function()
				part.CanCollide = true
			end)
		end
	end
end

toggleButton.MouseButton1Click:Connect(function()
	noclipEnabled = not noclipEnabled
	toggleButton.Text = noclipEnabled and "Tắt Noclip" or "Bật Noclip"
	toggleButton.BackgroundColor3 = noclipEnabled and Color3.fromRGB(0, 200, 0) or Color3.fromRGB(128, 128, 128)

	if noclipEnabled then
		enableNoclip(character)
	else
		disableNoclip(character)
	end
end)

-- Khi nhân vật mới hồi sinh
player.CharacterAdded:Connect(function(char)
	character = char
	wait(0.5) -- Đợi nhân vật load đủ

	-- Luôn tắt Noclip khi hồi sinh
	disableNoclip(char)
end)

-- Nút xóa
closeButton.MouseButton1Click:Connect(function()
	gui:Destroy()
end)
